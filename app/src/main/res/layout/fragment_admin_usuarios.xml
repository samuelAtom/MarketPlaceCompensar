<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/margin_medium"
    android:background="@color/background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gestión de Usuarios"
        style="@style/TitleText"
        android:layout_marginBottom="@dimen/margin_medium" />

    <!-- Barra de búsqueda -->
    <EditText
        android:id="@+id/etSearchUsers"
        android:layout_width="match_parent"
        android:layout_height="@dimen/input_height"
        android:hint="Buscar usuario..."
        android:background="@drawable/bg_rounded_card"
        android:paddingStart="@dimen/margin_medium"
        android:paddingEnd="@dimen/margin_medium"
        android:layout_marginBottom="@dimen/margin_medium" />

    <!-- Botón agregar usuario -->
    <Button
        android:id="@+id/btnAddUser"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:text="+ Agregar nuevo usuario"
        style="@style/RoundedButton"
        android:layout_marginBottom="@dimen/margin_medium" />

    <!-- Filtros por rol -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/margin_medium">

        <TextView
            android:id="@+id/filterAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Todos"
            android:background="@drawable/selector_button"
            android:textColor="@color/white"
            android:gravity="center"
            android:padding="8dp"
            android:layout_marginEnd="@dimen/margin_small" />

        <TextView
            android:id="@+id/filterCompradores"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Compradores"
            android:background="@drawable/bg_rounded_card"
            android:textColor="@color/primary"
            android:gravity="center"
            android:padding="8dp"
            android:layout_marginEnd="@dimen/margin_small" />

        <TextView
            android:id="@+id/filterVendedores"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Vendedores"
            android:background="@drawable/bg_rounded_card"
            android:textColor="@color/primary"
            android:gravity="center"
            android:padding="8dp" />

    </LinearLayout>

    <!-- Lista de usuarios -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvUsuarios"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>